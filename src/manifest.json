{
  "manifest_version": 3,
  "name": "久远的翻译工具",
  "version": "1.1.0",
  "description": "轻量双语翻译，支持 Google 和自带密钥的 AI 接口；按需翻译，保留网页布局。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/1.png",
    "48": "images/1.png",
    "128": "images/1.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "久远的翻译工具",
    "default_icon": {
      "16": "images/1.png",
      "48": "images/1.png",
      "128": "images/1.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "开启/关闭页面翻译"
    }
  },
  "minimum_chrome_version": "120",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
